# .dockerignore
# 排除不需要进入 Docker 构建上下文的文件
# 注意: 多阶段构建已确保最终镜像不含源码，这里只排除无用文件

# Git
.git
.gitignore
.gitattributes

# 环境变量（防止密钥泄露进镜像）
.env
.env.local
.env.*.local
.env.production
.env.production.local
.env.test.local

# 已有的构建产物
.next
dist
build
coverage
.turbo

# 开发文档
*.md
!README.md
docs/
.github/

# 测试文件
test/
tests/
__tests__/
*.test.js
*.spec.js
*.test.ts
*.spec.ts

# 依赖缓存（Docker 内重新安装）
node_modules
**/node_modules

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker 导出/部署文件
docker-exports/
scripts/
nginx/

# 其他项目子目录（前端构建不需要）
server/
admin-web/
license-server/
contracts/

# OS
.DS_Store
Thumbs.db

# 杂项
.cache
temp/
tmp/
