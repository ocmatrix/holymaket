# XMarket generic deployment configuration template
# Copy this file to a local, untracked .env file before filling real values.
# Keep PRIVATE_KEY, TESTNET_RPC_URL, MAINNET_RPC_URL, EXPLORER_API_KEY, and
# VERIFIER_URL empty in committed templates.

DEPLOY_PROFILE=LOCAL

LOCAL_RPC_URL=http://127.0.0.1:8545
TESTNET_RPC_URL=
MAINNET_RPC_URL=

PRIVATE_KEY=

COLLATERAL_MODE=MOCK
COLLATERAL_ADDRESS=

DEPLOY_STANDALONE_MARKET=true
DEPLOY_MARKET_FACTORY=true

MARKET_QUESTION="Will XMarket deploy successfully?"
MARKET_DURATION_SECONDS=604800
INITIAL_LIQUIDITY=1000000000
INITIAL_YES_AMOUNT=500000000
INITIAL_NO_AMOUNT=500000000

BROADCAST=false
VERIFY=false
EXPLORER_API_KEY=
VERIFIER_URL=

# Reserved profile metadata for future WANTOS Testnet / WANTOS Mainnet or
# other EVM deployments. Leave empty until a concrete network is approved.
CHAIN_NAME=
CHAIN_ID=
DEPLOYER_ADDRESS=
RESOLVER=
FEE_ROUTER=
TREASURY=

# Current Deploy.s.sol low-level variables.
# Leave COLLATERAL empty when COLLATERAL_MODE=MOCK so the script deploys
# MockUSDT automatically. Set COLLATERAL to COLLATERAL_ADDRESS only when using
# an approved external collateral token.
COLLATERAL=
QUESTION="Will XMarket deploy successfully?"
METADATA_URI=ipfs://xmarket/deployment-config-template
INITIAL_COLLATERAL=1000000000
INITIAL_PRICE_YES_BPS=5000
MIN_TRADE_AMOUNT=1
MAX_TRADE_AMOUNT=100000
MAX_SLIPPAGE_BPS=500
FEE_BPS=50

SYSTEM_MAX_FEE_BPS=500
SYSTEM_MAX_SLIPPAGE_BPS=1000
TRADE_CAP_BPS=1000
MIN_INITIAL_COLLATERAL=1000000
MIN_INITIAL_PRICE_YES_BPS=3000
MAX_INITIAL_PRICE_YES_BPS=7000

# Leave these unset to use script defaults, or set explicit unix timestamps for
# a real release rehearsal.
# START_TIME=
# END_TIME=

# Frontend public runtime configuration
NEXT_PUBLIC_XMARKET_INDEXER_API_BASE_URL=http://localhost:4000
