# ============================================
# AixL Platform - Production Environment
# 复制此文件为 .env.production 并填写实际值
# ============================================

# ============ 数据库 ============
DB_USER=aixl
DB_PASSWORD=your-strong-db-password-here
DB_NAME=aixl

# ============ Redis ============
REDIS_PASSWORD=your-strong-redis-password-here

# ============ 授权系统 ============
LICENSE_KEY=AIXL-XXXX-XXXX-XXXX
LICENSE_SERVER=http://43.157.56.23:3100
LICENSE_FORCE_STOP=false

# ============ 安全 ============
JWT_SECRET=your-jwt-secret-at-least-32-characters
JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-32-characters
ADMIN_JWT_SECRET=your-admin-jwt-secret-at-least-32-characters
ADMIN_BOOTSTRAP_USERNAME=your-initial-admin-username
ADMIN_BOOTSTRAP_PASSWORD=your-one-time-initial-admin-password

# ============ Privy 认证 ============
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# ============ AI 服务 ============
OPENAI_API_KEY=sk-your-openai-api-key

# ============ 第三方 API ============
PANDASCORE_API_KEY=your-pandascore-api-key
FOOTBALL_API_KEY=your-football-api-key

# ============ Indexer ============
INDEXER_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
INDEXER_CHAIN_ID=97
INDEXER_START_BLOCK=0
INDEXER_CONFIRMATIONS=12
INDEXER_BATCH_SIZE=5000
INDEXER_MAX_BLOCKS_PER_RUN=20000
INDEXER_SYNC_INTERVAL_SECONDS=15
INDEXER_DB_SCHEMA=indexer

# ============ 前端配置 (构建时写入镜像) ============
NEXT_PUBLIC_API_URL=https://superoctopus.fun/api
NEXT_PUBLIC_WS_URL=wss://superoctopus.fun
NEXT_PUBLIC_BACKEND_URL=https://superoctopus.fun/api
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
NEXT_PUBLIC_XMARKET_INDEXER_API_BASE_URL=https://superoctopus.fun/indexer

# ============ 管理后台配置 ============
NEXT_PUBLIC_ADMIN_API_URL=https://superoctopus.fun/api
NEXT_PUBLIC_ADMIN_WS_URL=wss://superoctopus.fun

# ============ XMarket Admin Chain Ops ============
XMARKET_ADMIN_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
XMARKET_ADMIN_PRIVATE_KEY=0xyour-admin-private-key
XMARKET_MARKET_FACTORY_ADDRESS=0x45ab369f65c0ef44c1325323f283e6acc92b8bd0
XMARKET_COLLATERAL_ADDRESS=0xb90278a476319CbDAd259e4fEAA8E7d9Da05e1EB
XMARKET_COLLATERAL_DECIMALS=6
XMARKET_DEFAULT_INITIAL_COLLATERAL=1000000
XMARKET_DEFAULT_INITIAL_PRICE_YES_BPS=5000
XMARKET_DEFAULT_MIN_TRADE_AMOUNT=1
XMARKET_DEFAULT_MAX_TRADE_AMOUNT=100000
XMARKET_DEFAULT_MAX_SLIPPAGE_BPS=500
XMARKET_DEFAULT_FEE_BPS=50

# ============ CORS ============
CORS_ORIGINS=https://superoctopus.fun,https://www.superoctopus.fun,https://admin.superoctopus.fun
SWAGGER_ENABLED=false
