# BSC Testnet public RPC. Replace locally if needed.
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Indexer target chain.
INDEXER_CHAIN_ID=97

# PostgreSQL database URL for local development.
# Do not commit real credentials in .env.
DATABASE_URL="postgresql://xmarket:xmarket@localhost:5432/xmarket_indexer?schema=public"

# Event sync settings.
# Use a safer deployment-adjacent start block in real environments when known.
INDEXER_START_BLOCK=0
INDEXER_CONFIRMATIONS=12
INDEXER_BATCH_SIZE=5000
INDEXER_MAX_BLOCKS_PER_RUN=20000

# Read-only API port.
INDEXER_API_PORT=4000
